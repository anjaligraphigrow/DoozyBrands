{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Office System application",
  "author": "DoozyBrands",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && npx @electron/packager . DoozyBrands --platform=win32 --arch=x64 --out=release --overwrite --tmpdir=.tmp-electron-packager --app-version=0.0.0 --win32metadata.CompanyName=\"DoozyBrands\" --win32metadata.FileDescription=\"Office System\" --win32metadata.ProductName=\"DoozyBrands\""
  },
  "dependencies": {
    "axios": "^1.19.0",
    "emoji-picker-react": "^4.19.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.doozybrands.app",
    "productName": "DoozyBrands",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json",
      "package-lock.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
